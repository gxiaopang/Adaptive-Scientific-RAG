# Copy to .env and replace every credential/model placeholder required by your providers.
# Never expose these backend-only secrets through Vite or browser code.
ASR_APP_NAME=Adaptive Scientific RAG
ASR_APP_ENV=development
ASR_LOG_LEVEL=INFO
ASR_HOST=0.0.0.0
ASR_PORT=8000
ASR_SCIFACT_DATA_DIR=./scifact
ASR_CORS_ORIGINS=["http://127.0.0.1:5173"]

# PostgreSQL / pgvector
ASR_POSTGRES_DSN=postgresql+psycopg://adaptive_rag:adaptive_rag_dev@127.0.0.1:55432/adaptive_rag
ASR_MEMORY_MAX_TURNS=8
ASR_MEMORY_MAX_CHARACTERS=8000

# OpenAI-compatible embedding endpoint. Qwen is the checked-in default identity.
ASR_EMBEDDING_API_KEY=
ASR_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ASR_EMBEDDING_PROVIDER=alibaba-model-studio
ASR_EMBEDDING_MODEL=qwen3.7-text-embedding
ASR_EMBEDDING_DIMENSION=1024
ASR_EMBEDDING_BATCH_SIZE=10
ASR_EMBEDDING_TIMEOUT_SECONDS=30
ASR_EMBEDDING_MAX_RETRIES=2

# Qwen text-rerank endpoint; use credentials independent from embedding.
ASR_RERANKER_API_KEY=
ASR_RERANKER_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
ASR_RERANKER_PROVIDER=alibaba-model-studio
ASR_RERANKER_MODEL=qwen3.7-text-rerank
ASR_RERANKER_TIMEOUT_SECONDS=30
ASR_RERANKER_MAX_RETRIES=2
ASR_RERANKER_INSTRUCTION=Given a scientific claim or question, retrieve passages that provide relevant evidence.

# OpenAI-compatible Chat Completions endpoint; credentials are independent.
ASR_LLM_API_KEY=
ASR_LLM_BASE_URL=https://api.openai.com/v1
ASR_LLM_MODEL=
ASR_LLM_TIMEOUT_SECONDS=60
ASR_LLM_MAX_RETRIES=2
ASR_LLM_TEMPERATURE=0
ASR_LLM_MAX_TOKENS=800

# Docker Compose only
POSTGRES_USER=adaptive_rag
POSTGRES_PASSWORD=adaptive_rag_dev
POSTGRES_DB=adaptive_rag
POSTGRES_PORT=55432
APP_PORT=8000
FRONTEND_PORT=3000
